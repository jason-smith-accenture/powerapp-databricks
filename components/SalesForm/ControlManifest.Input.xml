<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control
    namespace="Demo"
    constructor="SalesFormControl"
    version="0.0.1"
    display-name-key="SalesForm"
    description-key="Sales Form PCF Component"
    control-type="virtual"
  >

    <external-service-usage enabled="false">
    </external-service-usage>

    <property
      name="submittedData"
      display-name-key="Submitted Data"
      description-key="JSON data submitted by the sales form"
      of-type="SingleLine.Text"
      usage="output"
    />

    <resources>
      <code path="src/index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.4.0" />
    </resources>

  </control>
</manifest>